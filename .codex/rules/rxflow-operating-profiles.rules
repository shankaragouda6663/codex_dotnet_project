prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["dotnet", "build"], decision="allow")
prefix_rule(pattern=["dotnet", "test"], decision="allow")
prefix_rule(pattern=["dotnet", "format"], decision="allow")
prefix_rule(pattern=["pwsh", "-File", "scripts/codex-profiles/verify-profile.ps1"], decision="allow")
prefix_rule(pattern=["pwsh", "-File", "scripts/codex-profiles/run-ci-analysis.ps1"], decision="allow")
prefix_rule(pattern=["pwsh", "-File", "scripts/codex-profiles/create-remediation-worktree.ps1"], decision="allow")
prefix_rule(pattern=["pwsh", "-File", "scripts/codex-profiles/cleanup-remediation-worktree.ps1"], decision="allow")
